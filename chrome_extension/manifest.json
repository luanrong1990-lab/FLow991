{
  "manifest_version": 3,
  "name": "VQPVEO3PRO - Flow Bridge",
  "version": "1.0",
  "description": "Cầu nối tự động hóa giữa Desktop App và Google Flow.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "windows",
    "downloads"
  ],
  "host_permissions": [
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://flow.google.com/*"],
      "js": ["content/flow_controller.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VQPVEO3PRO Flow Bridge"
  }
}
